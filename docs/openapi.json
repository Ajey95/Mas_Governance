    "/scalability/batch": {
      "get": {
        "summary": "Scalability Batch",
        "operationId": "scalability_batch_scalability_batch_get",
        "parameters": [
          {
            "name": "max_workers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 4,
              "title": "Max Workers"
            }
          },
          {
            "name": "chunk_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "title": "Chunk Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
