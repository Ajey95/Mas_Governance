  "components": {
    "schemas": {
      "AgreementRequest": {
        "properties": {
          "labels_a": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Labels A"
          },
          "labels_b": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Labels B"
          }
        },
        "type": "object",
        "required": [
          "labels_a",
          "labels_b"
        ],
        "title": "AgreementRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
